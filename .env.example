# Database (Neon / Postgres)
# Prefer the pooled Prisma URL for the app; non-pooling for migrations if needed.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DB?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB"

# Clerk (optional — leave empty for local/dev without auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Blob (quiz/question image uploads)
BLOB_READ_WRITE_TOKEN=

# AI quiz generation (server-only)
GEMINI_QUIZ_API_KEY=

# Client image search (exposed to the browser)
NEXT_PUBLIC_PIXABAY_API_KEY=
NEXT_PUBLIC_GIPHY_API_KEY=
