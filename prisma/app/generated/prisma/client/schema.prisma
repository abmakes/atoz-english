// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "app/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Quiz {
  id              String         @id @default(cuid())
  title           String
  description     String?
  imageUrl        String? // For Giphy URLs and direct uploads
  quizType        QuestionType   @default(MULTIPLE_CHOICE)
  tags            String[]
  statistics      Json? // { likes, favoritesCount, playsCount }
  defaultSettings Json? // Added: To store default game settings for this quiz
  authorId        String         @default("admin")
  questions       Question[]
  likes           QuizLike[]
  favorites       QuizFavorite[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model QuizLike {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId])
}

model QuizFavorite {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId])
}

model Question {
  id            String       @id @default(cuid())
  question      String
  imageUrl      String? // For Giphy URLs, direct uploads, and stored Pixabay images
  answers       String[]
  correctAnswer String
  type          QuestionType @default(MULTIPLE_CHOICE)
  quiz          Quiz?        @relation(fields: [quizId], references: [id])
  quizId        String?
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  SORTING
  MATCHING
  FILL_IN_THE_BLANK
  TWO_OPTIONS
  OPEN_ENDED
  // Add more types as needed
}

enum Level {
  PRE_A1
  A1
  A2
  B1
  B2
  C1
  C2
  // Add more types as needed
}

model StoredImage {
  id          String @id @default(cuid())
  filename    String // Blob filename (e.g., "pixabay_123456_640.jpg")
  originalUrl String // Original Pixabay URL for reference
  blobUrl     String // Vercel Blob URL for serving the image
  mimeType    String // image/jpeg, image/png, etc.
  fileSize    Int // File size in bytes
  width       Int // Image width
  height      Int // Image height

  // Metadata for search and organization
  searchTerm  String? // Original search term used to find this image
  tags        String[] // Tags associated with this image
  pixabayId   Int      @unique // Original Pixabay image ID (unique to prevent duplicates)
  pixabayUser String? // Original Pixabay user who uploaded

  // Usage tracking
  usageCount Int       @default(0) // How many times this image has been used
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([searchTerm])
  @@index([tags])
  @@index([usageCount])
  @@index([pixabayId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StoryStatus {
  DRAFT
  READY
  ARCHIVED
}

enum StorySubmissionStatus {
  SUBMITTED
  REVIEWED
}

/// Teacher Tools: 4-panel picture story for Cambridge Movers storytelling practice.
model Story {
  id                    String            @id @default(cuid())
  authorId              String            @default("admin")
  title                 String
  topicPrompt           String
  tags                  String[] // discovery tags: level, topic, grammar
  storyType             String?
  characterSheet        String? // AI character description reused for image (re)generation
  artStyle              String? // AI art style locked at first generation
  exampleStory          String? // full example text shown on the printout
  showExampleToStudents Boolean           @default(false)
  status                StoryStatus       @default(DRAFT)
  shareToken            String            @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  panels                StoryPanel[]
  submissions           StorySubmission[]

  @@index([authorId])
}

model StoryPanel {
  id               String  @id @default(cuid())
  storyId          String
  order            Int // 1-4
  imageUrl         String? // Vercel Blob; null until generated
  sceneDescription String // AI scene text, reused for regeneration
  imagePrompt      String? // full prompt used for the last generation
  exampleSentence  String?
  mouth            Json? // { x, y, scale, rotation, style } normalized 0-1
  story            Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, order])
}

model StorySubmission {
  id          String                @id @default(cuid())
  storyId     String
  studentName String
  status      StorySubmissionStatus @default(SUBMITTED)
  createdAt   DateTime              @default(now())
  recordings  StoryRecording[]
  story       Story                 @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

model StoryRecording {
  id           String          @id @default(cuid())
  submissionId String
  panelOrder   Int // 1-4
  audioUrl     String // Vercel Blob
  mimeType     String // audio/webm (Chrome/Android) or audio/mp4 (iOS Safari)
  durationMs   Int
  envelope     Json? // number[] amplitude envelope (RMS per 50 ms window, 0-1)
  submission   StorySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, panelOrder])
}
